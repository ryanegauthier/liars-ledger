# Liar's Ledger API - environment variables
# Copy to .env for local dev. Set these in Render environment variables for production.
# NEVER commit .env to git.

# ── Anthropic Claude ─────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-...

# ── Mistral AI ────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=...

# ── Congress.gov ──────────────────────────────────────────────────────────────
CONGRESS_API_KEY=...

# ── VoteSmart v2 ──────────────────────────────────────────────────────────────
VOTESMART_EMAIL=ryan@liarsledger.com
VOTESMART_PASSWORD=...

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Required - install tokens, scan counts, and Square subscription mappings all
# live in Redis (see server/providers/store.js). The server errors on nearly
# every request without this. Free tier: create a database at
# https://upstash.com, then copy the REST URL and REST token from its
# dashboard (not the redis:// connection string - the REST API is what the
# @upstash/redis client here uses).
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS - comma-separated list of allowed origins ────────────────────────────
# For dev: chrome-extension://YOUR_EXTENSION_ID
# For prod: include the extension ID AND liarsledger.com (for /checkout/create)
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here,https://liarsledger.com

# ── Backend public URL (used to construct the Square webhook notification URL) ─
BACKEND_URL=https://api.liarsledger.com

# ── Square ────────────────────────────────────────────────────────────────────
# Access token: Square Developer Console → your app → Credentials
# Use sandbox token for dev, production token for prod.
SQUARE_ACCESS_TOKEN=EAAAl...

# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox

# Square Developer Console → your app → Locations → copy any location ID
SQUARE_LOCATION_ID=...

# IDs from running: node server/scripts/setup-square-catalog.mjs
SQUARE_PLAN_ID=...
SQUARE_PLAN_VARIATION_ID=...

# Square Developer Console → your app → Webhooks → your endpoint → Signature Key
SQUARE_WEBHOOK_SIGNATURE_KEY=...
# Must exactly match the URL registered in Square Dashboard (scheme + path, no trailing slash)
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api.liarsledger.com/webhook/square
# The pricing website origin (used for the success redirect URL and CORS)
PRICING_SITE_URL=https://liarsledger.com

# ── X (Twitter) bot ───────────────────────────────────────────────────────────
# Mention-triggered bot (server/bot/*) - separate from the extension/backend
# proxy above. Needs a paid X API tier with write access (Free tier is
# read-restricted) - create a Project + App at https://developer.x.com and
# generate OAuth 1.0a keys with Read+Write permission (four keys below, not
# OAuth 2.0 - avoids an interactive re-auth flow for a long-running bot).
X_API_KEY=...
X_API_SECRET=...
X_ACCESS_TOKEN=...
X_ACCESS_SECRET=...
# Bot's own @handle, without the @ - used to avoid replying to itself
X_BOT_USERNAME=...

# Liar's Ledger anonymous token the bot scans through - register once via
# `node server/bot/registerBotToken.js`, then upgrade it to Pro (see
# CLAUDE.md's Redis data model section for the manual-upgrade curl command)
# since /api/verify-claim requires Pro tier.
LL_BOT_TOKEN=...
# Base URL of the deployed backend the bot calls - production by default,
# point at http://localhost:3001 for local testing.
LL_API_BASE=https://api.liarsledger.com
